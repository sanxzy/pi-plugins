{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "paths": {
      "@xzy-ai/core": ["./packages/core/src/index.ts"],
      "@xzy-ai/core/*": ["./packages/core/src/*", "./packages/core/src/*.ts"],
      "@xzy-ai/observability": ["./packages/observability/src/index.ts"],
      "@xzy-ai/observability/*": ["./packages/observability/src/*", "./packages/observability/src/*.ts"],
      "@xzy-ai/runtime": ["./packages/runtime/src/index.ts"],
      "@xzy-ai/runtime/*": ["./packages/runtime/src/*", "./packages/runtime/src/*.ts"],
      "@xzy-ai/tools": ["./packages/tools/src/index.ts"],
      "@xzy-ai/tools/*": ["./packages/tools/src/*", "./packages/tools/src/*.ts"],
      "@xzy-ai/commands": ["./packages/commands/src/index.ts"],
      "@xzy-ai/commands/*": ["./packages/commands/src/*", "./packages/commands/src/*.ts"],
      "@xzy-ai/tui": ["./packages/tui/src/index.ts"],
      "@xzy-ai/tui/*": ["./packages/tui/src/*", "./packages/tui/src/*.ts"],
      "@xzy-ai/channels": ["./packages/channels/src/index.ts"],
      "@xzy-ai/channels/*": ["./packages/channels/src/*", "./packages/channels/src/*.ts"],
      "@xzy-ai/mcp": ["./packages/mcp/src/index.ts"],
      "@xzy-ai/mcp/*": ["./packages/mcp/src/*", "./packages/mcp/src/*.ts"],
      "@xzy-ai/pi-c2": ["./packages/extensions/pi-c2/index.ts"]
    }
  }
}
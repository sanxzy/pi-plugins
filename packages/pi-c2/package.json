{
  "name": "@xzy-ai/pi-c2",
  "version": "0.1.0",
  "description": "PI extension: delegate work to isolated in-process subagents through model-callable tools",
  "type": "module",
  "main": "./index.ts",
  "pi": {
    "extensions": ["./index.ts"]
  },
  "private": true,
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "test": "node --test --import ../../test-setup.mjs --import tsx tests/extension.test.ts tests/manager-removal.test.ts"
  },
  "dependencies": {
    "@xzy-ai/commands": "workspace:*",
    "@xzy-ai/core": "workspace:*",
    "@xzy-ai/mcp": "workspace:*",
    "@xzy-ai/runtime": "workspace:*",
    "@xzy-ai/tools": "workspace:*",
    "@earendil-works/pi-coding-agent": "^0.84.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.22.2"
  }
}
